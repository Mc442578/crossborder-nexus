{
  "name": "product-picker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -n bff,web -c magenta,cyan \"npm:dev:bff\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:bff": "node --env-file-if-exists=.env --use-env-proxy server/index.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --test",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "pinia": "^2.2.6",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vue-tsc": "^2.1.10"
  }
}
